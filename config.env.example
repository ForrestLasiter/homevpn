# ======================================================================
#  Home VPN — one config for every script.
#  Copy to config.env and edit. Every script auto-loads config.env if it
#  sits next to it (or at /opt/wg-hub/config.env inside the container).
#
#      cp config.env.example config.env
#      nano config.env
#
#  config.env is git-ignored — it may hold your DuckDNS token, so it must
#  never be committed. Only this .example file lives in the repo.
# ======================================================================

# ---- Proxmox host: the container to create (create-lxc.sh) -----------
CTID=910                       # unused container ID
CT_HOSTNAME=wg-hub
STORAGE=local-lvm              # Proxmox storage for the rootfs
BRIDGE=vmbr0                   # your LAN bridge
DISK_GB=4
RAM_MB=512
CORES=1
UNPRIVILEGED=1                 # 1 = unprivileged container (recommended)
# Give the container a fixed LAN IP so the router port-forward always
# lands right. Match your own LAN (find it on the host with `ip -4 route`) —
# pick a free address on it, or use "dhcp" + a router DHCP reservation.
NET_IP=dhcp                    # e.g. 192.168.1.10/24
NET_GW=                        # e.g. 192.168.1.1   (blank when NET_IP=dhcp)
CT_NAMESERVER=1.1.1.1          # DNS for the container (needed with a static IP)

# ---- WireGuard hub (bootstrap.sh) ------------------------------------
WG_PORT=51820                  # UDP port you forward on the router
WG_ADDR=10.10.10.1             # the hub's address inside the VPN
WG_CIDR=24                     # => VPN subnet 10.10.10.0/24
HOME_LAN=192.168.1.0/24        # your home LAN (for split-tunnel clients)
CLIENT_DNS=1.1.1.1             # DNS handed to clients; set to 10.10.10.1 after Pi-hole

# ---- DuckDNS: keeps your changing home IP reachable ------------------
DUCKDNS_DOMAIN=                # e.g. myhomelab   (no .duckdns.org)
DUCKDNS_TOKEN=                 # the token from https://www.duckdns.org

# ---- Pi-hole ad blocking (pihole-setup.sh) ---------------------------
PIHOLE_PASSWORD=changeme-admin
UPSTREAM_DNS_1=1.1.1.1
UPSTREAM_DNS_2=9.9.9.9

# ---- Phase 2: cloud VPS exit node (vps/bootstrap-exit.sh) ------------
VPS_WG_PORT=51820
VPS_WG_ADDR=10.20.0.1          # exit's address on its own VPN subnet
VPS_WG_CIDR=24
